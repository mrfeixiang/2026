# InkScape AI — Backend configuration
# Copy to .env and fill in what you have. EVERYTHING is optional:
# with no keys at all, the backend still produces a finished 国画 poster
# using local Pillow stylization + preset poems/titles/seals.

# ---- OpenAI (optional) ----
# When set, photos are analyzed by GPT and poems/titles are written by GPT.
# When empty, curated presets per style are used instead.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Image generation backend (optional) ----
# One of: "local" (Pillow ink stylization, default), "comfyui", "flux"
GENERATOR=local

# ComfyUI (only if GENERATOR=comfyui)
COMFYUI_URL=http://127.0.0.1:8188

# Flux via Replicate or a compatible endpoint (only if GENERATOR=flux)
FLUX_API_URL=
FLUX_API_KEY=

# ---- Output ----
OUTPUT_DIR=outputs
MAX_UPLOAD_MB=15
POSTER_LONG_EDGE=1536
